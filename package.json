{
  "name": "cdk-snippets",
  "displayName": "AWS CDK Snippets",
  "description": "Adds L1 Construct snippets from AWS CDK in VS Code.",
  "author": "Danny Steenman",
  "version": "2.115.1",
  "publisher": "dannysteenman",
  "icon": "images/cdk-snippets-extension-icon.png",
  "homepage": "https://towardsthecloud.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/towardsthecloud/vscode-cdk-snippets"
  },
  "engines": {
    "vscode": "^1.31.0"
  },
  "galleryBanner": {
    "color": "#2B2C33",
    "theme": "dark"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "aws",
    "cdk",
    "construct",
    "typescript",
    "python"
  ],
  "scripts": {
    "generate": "python3 src/update-cdk-construct-snippets.py",
    "test:generator": "python3 -m unittest discover -s tests -v",
    "generate:check": "python3 src/update-cdk-construct-snippets.py --check",
    "test:release": "node --test tests/release*.test.cjs",
    "test:snippets": "node scripts/validate-snippets.cjs && python3 scripts/validate-python.py",
    "test": "npm run test:generator && npm run test:release && npm run generate:check && npm run test:snippets",
    "test:vscode": "node scripts/test-vscode.cjs",
    "package": "node -e \"require('node:fs').mkdirSync('artifacts', {recursive:true})\" && vsce package --no-dependencies --out artifacts/cdk-snippets.vsix",
    "test:package": "node scripts/validate-package.cjs",
    "release:prepare": "node scripts/prepare-release.cjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1",
    "jszip": "3.10.2",
    "ovsx": "1.2.0",
    "typescript": "7.0.2"
  },
  "contributes": {
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/cdk-l1-constructs-python.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/cdk-l1-constructs-typescript.json"
      }
    ]
  },
  "overrides": {
    "ovsx": {
      "@vscode/vsce": "$@vscode/vsce"
    }
  }
}
